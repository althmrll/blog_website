<div>
  <h1 class="font-bold text-4xl">Sessions#new</h1>
  <p>Find me in app/views/sessions/new.html.erb</p>
</div>
<div style="max-w-md; margin: 2rem auto; padding: 1.5rem; border: 1px solid #ccc; border-radius: 8px;">
  <h2>Log In</h2>

  <%= form_with(url: login_path, local: true) do |f| %>
    <div style="margin-bottom: 1rem;">
      <%= f.label :username %><br>
      <%= f.text_field :username, required: true, style: "width: 100%; padding: 0.5rem;" %>
    </div>

    <div style="margin-bottom: 1rem;">
      <%= f.label :password %><br>
      <%= f.password_field :password, required: true, style: "width: 100%; padding: 0.5rem;" %>
    </div>

    <%= f.submit "Log In", style: "padding: 0.5rem 1rem; background: #0284c7; color: white; border: none; border-radius: 4px; cursor: pointer;" %>
  <% end %>
</div>