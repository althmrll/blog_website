<p style="color: green"><%= notice %></p>
<div class= "bg-white p-5 rounded-lg border border-gray-200 shadow-sm">
<%= button_to "Back", posts_path, method: :get, class:"text-blue-600 hover:underline font-medium"%><br>
<%= render @post %><br>

<div class="flex flex-row gap-5">
  <%= button_to "Edit", edit_post_path(@post), method: :get, class:"text-blue-600 hover:underline font-medium" %>
  <%= button_to "Delete", @post, method: :delete, class:"text-blue-600 hover:underline font-medium"%>
</div>
</div>

<div class="mx-auto">
<div>
<h1 class="font-bold text-4xl mt-8 mb-5">Comments</h1>
<% @post.comments.each do |comment| %>
  <div class="mb-5 border-l-4 border-gray-300 pl-4">
    <p><%= comment.content %></p>
    <div class="flex gap-3 text-sm mt-2">
      <%= link_to "Edit", edit_post_comment_path(@post, comment), class: "text-blue-600 hover:underline" %>
      <%= button_to "Delete", [@post, comment], method: :delete, class: "text-red-600 hover:underline bg-transparent border-none p-0 cursor-pointer" %>
    </div>
  </div>
<% end %>

<%= form_with(model: [@post, Comment.new]) do |f| %>
  <div class: "font-semibold text-gray-700 text-lg" %>
  </div>
    <%= f.text_area :content, placeholder: "Enter comment...", rows: 3, class: "w-300 p-3 bg-white border border-gray-300 rounded-lg text-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-sm"%>
  </div>

  <div>
    <%= f.submit "Post Comment", class: "mt-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold gap-2 py-2.5 px-5 rounded-lg shadow cursor-pointer transition"%>
  </div>
  <% end %>
</div>
</div>