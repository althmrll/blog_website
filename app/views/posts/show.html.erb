<p style="color: green"><%= notice %></p>
<div class= "bg-white p-5 rounded-lg border border-gray-200 shadow-sm">
<%= button_to "Back", posts_path, method: :get, class:"text-blue-600 hover:underline font-medium"%><br>
<%= render @post %><br>

<div class="flex flex-row gap-5">
  <%= button_to "Edit", edit_post_path(@post), method: :get, class:"text-blue-600 hover:underline font-medium" %>
  <%= button_to "Delete", @post, method: :delete, class:"text-blue-600 hover:underline font-medium"%>
</div>
</div>

<div>
<h1 class="font-bold text-4xl">Comments</h1>
<% @post.comments.each do |comment| %>
  <div style="border-left: 3px solid #ccc; padding-left: 10px; margin-bottom: 10px;">
    <p><%= comment.content %></p>
  </div>
<% end %>

<%= form_with(model: [@post, Comment.new]) do |f| %>
  <div>
    <%= f.label :content, "Your Comment" %><br>
    <%= f.text_area :content, rows: 3 %>
  </div>

  <div>
    <%= f.submit "Post Comment" %>
  </div>
<% end %>
</div>