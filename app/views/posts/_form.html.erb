<%= form_with(model: post, class: "space-y-6 max-w-2xl") do |form| %>
  <% if post.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>

      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex flex-col gap-2">
    <%= form.label :title, class: "font-semibold text-gray-700 text-lg" %>
    <%= form.text_field :title, class: "w-full p-3 bg-white border border-gray-300 rounded-lg text-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-sm" %>
  </div>

  <div class="flex flex-col gap-2">
    <%= form.label :content, class: "font-semibold text-gray-700 text-lg" %>
    <%= form.text_area :content, rows: 5, class: "w-full p-3 bg-white border border-gray-300 rounded-lg text-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-sm" %>
  </div>

  <div>
    <%= form.submit "Create Post", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-5 rounded-lg shadow cursor-pointer transition" %>
  </div>
<% end %>
