<p style="color: green"><%= notice %></p>

<% content_for :title, "Posts" %>

<h1>Posts</h1>
<%= button_to "New post", new_post_path, method: :get %><br><br><br>
<div id="posts">
  <% @posts.each do |post| %>
    <%= render post %>
    <p>
      <%= button_to "Show this post", post, method: :get %><br><br>
    </p>
  <% end %>
</div>
