<p style="color: green"><%= notice %></p>

<% content_for :title, "Posts" %>

<h1 class="font-bold">Posts</h1>
<%= button_to "New post", new_post_path, method: :get, class:"text-white rounded-full bg-[#0000FF] hover:bg-[#5C5CFF] py-2 px-3"%><br><br><br>
<div id="posts">
  <% @posts.each do |post| %>
    <%= render post %>
    <p>
      <%= button_to "Show this post", post, method: :get %><br><br>
    </p>
  <% end %>
</div>
