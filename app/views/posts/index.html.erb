<div class="flex flex-col gap-6">
<% content_for :title, "Posts" %>

<h1 class="font-bold text-4xl">Posts</h1>
<%= button_to "+ New post", new_post_path, method: :get, class:"text-white rounded-full bg-[#0000FF] hover:bg-[#5C5CFF] py-2 px-3"%><br><br>
  <div class="space-y-4">
    <% @posts.each do |post| %>
      
      <div class="bg-white p-5 rounded-lg border border-gray-200 shadow-sm">
        <h2 class="font-bold text-3xl mb-2"><%= link_to post.title.camelize, post %></h2>
        <% if post.tags.any? %>
          <div class="display-flex flex-wrap-wrap mb-4">
            <% post.tags.each do |tag| %>
            <% next if tag.name.blank? %>
            <span class="text-s text-blue-600 hover:underline">
              #<%= tag.name %>
            </span>
            <%end%>
          </div>
        <%else%>
          <span class="text-gray-500">No tags</span>
          </span>
        <% end %>
      </div>
    <%end%>
  </div>
</div>